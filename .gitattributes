# Keep line endings predictable no matter who checks the repo out.
* text=auto eol=lf

*.lua  text eol=lf
*.toc  text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf

# Art and audio the game loads directly.
*.tga  binary
*.blp  binary
*.png  binary
*.ttf  binary
*.ogg  binary
*.mp3  binary
